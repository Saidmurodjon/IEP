{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "paths": {
      "@energetika/db": [
        "../../packages/db/src/index.ts"
      ],
      "@energetika/shared": [
        "../../packages/shared/src/index.ts"
      ]
    },
    "types": [
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "src"
  ]
}
