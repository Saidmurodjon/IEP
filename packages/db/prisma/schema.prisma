generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model News {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleUz     String
  titleEn     String
  titleRu     String
  summaryUz   String
  summaryEn   String
  summaryRu   String
  contentUz   String   @db.Text
  contentEn   String   @db.Text
  contentRu   String   @db.Text
  imageUrl    String?
  // 373-son qaror, 4-band: boshqa manbadan olingan axborot faqat manba
  // ko'rsatilgan holda joylashtiriladi.
  sourceName  String?
  sourceUrl   String?
  /// Qoralama ochiq sahifada KO'RINMAYDI. Nashr etish alohida amal.
  isPublished Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("news")
}

model Publication {
  id        String   @id @default(cuid())
  titleUz   String
  titleEn   String
  titleRu   String
  authors   String
  journal   String?
  year      Int
  doi       String?
  fileUrl   String?
  category  String   @default("article")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("publications")
}

model StructureUnit {
  id            String          @id @default(cuid())
  nameUz        String
  nameEn        String
  nameRu        String
  descriptionUz String          @default("") @db.Text
  descriptionEn String          @default("") @db.Text
  descriptionRu String          @default("") @db.Text
  head          String?
  type          String          @default("department")
  // Shtat birligi soni (hujjatdagi raqam). Direktor/Ilmiy kengash kabi birliklarda ko'rsatilmagan → nullable.
  staffCount    Int?
  // Ilmiy kengash — maslahat organi (hujjatda punktir chiziq), bo'ysunuvchi emas.
  isAdvisory    Boolean         @default(false)
  order         Int             @default(0)
  parentId      String?
  parent        StructureUnit?  @relation("StructureHierarchy", fields: [parentId], references: [id])
  children      StructureUnit[] @relation("StructureHierarchy")
  employees     Employee[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("structure_units")
}

/// Institut xodimi. Ism uchala tilda ALOHIDA saqlanadi — ruscha variant
/// kirill yozuvida bo'ladi va uni avtomatik hosil qilib bo'lmaydi.
///
/// DIQQAT: saytda faqat XIZMAT telefoni va XIZMAT pochtasi e'lon qilinadi.
/// Shaxsiy mobil raqam yoki shaxsiy pochta bu yerga yozilmaydi.
model Employee {
  id                String   @id @default(cuid())
  fullNameUz        String
  fullNameEn        String
  fullNameRu        String
  positionUz        String
  positionEn        String
  positionRu        String
  // Ilmiy daraja (f.-m.f.n., PhD va h.k.) — bo'lmasligi mumkin
  degreeUz          String?
  degreeEn          String?
  degreeRu          String?
  // Ilmiy unvon (dotsent, professor) — bo'lmasligi mumkin
  titleUz           String?
  titleEn           String?
  titleRu           String?
  email             String?
  phone             String?
  photoUrl          String?
  orcid             String?
  scopusId          String?
  researchAreaUz    String?
  researchAreaEn    String?
  researchAreaRu    String?
  officeRoom        String?
  // Qabul jadvali erkin matn: muassasada u buyruq bilan belgilanadi va
  // shakli o'zgarib turishi mumkin, shuning uchun tuzilmali saqlanmaydi.
  receptionHoursUz  String?
  receptionHoursEn  String?
  receptionHoursRu  String?
  isManagement      Boolean  @default(false)
  isUnitHead        Boolean  @default(false)
  // Bo'linma o'chirilsa xodim o'chmaydi — bog'lanish uziladi.
  unitId            String?
  unit              StructureUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  order             Int      @default(0)
  // Ishdan ketgan xodim O'CHIRILMAYDI, faqat `false` qilinadi.
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([unitId])
  @@map("employees")
}

/// Hamkor tashkilot. Logotip — tashkilotning savdo belgisi, shuning uchun
/// faqat institut taqdim etgan ro'yxat bo'yicha to'ldiriladi.
model Partner {
  id         String   @id @default(cuid())
  nameUz     String
  nameEn     String
  nameRu     String
  logoUrl    String
  websiteUrl String?
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("partners")
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

/// Fuqaro murojaati.
///
/// VM ning 2021-yil 15-iyundagi 373-son qarori, 11-bandi murojaatning
/// ko'rib chiqilish holatini kuzatib borishni talab qiladi — shu sababli
/// `ticketNumber` va `status` maydonlari bor.
///
/// DIQQAT: bu jadval SHAXSIY MA'LUMOT saqlaydi. Xatlarga murojaat matni va
/// telefon raqami qo'shilmaydi, ular faqat admin panelda ko'riladi.
model ContactMessage {
  id              String    @id @default(cuid())
  /// `M-YYYY-NNNN`. Fuqaro uni telefonda aytishi mumkin, shuning uchun
  /// qisqa va ketma-ket.
  ticketNumber    String    @unique
  name            String
  email           String
  phone           String?
  subject         String
  message         String    @db.Text
  /// `new`, `in_review`, `answered`, `closed`
  status          String    @default("new")
  statusChangedAt DateTime  @default(now())
  answeredAt      DateTime?
  /// Ichki izoh — fuqaroga KO'RINMAYDI.
  answerNote      String?   @db.Text
  /// Tasdiq xati yuborilgan vaqt. `null` — xat yuborilmagan
  /// (masalan `RESEND_API_KEY` o'rnatilmagan).
  notifiedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([status, createdAt])
  @@map("contact_messages")
}

/// Omborga yuklangan fayl. Bu jadval bo'lmasa tahrirlashda eski faylni
/// o'chirish va yozuv o'chirilganda omborni tozalash imkonsiz bo'ladi.
///
/// `ownerId` bo'sh fayl EGASIZ hisoblanadi (moderator rasm yukladi, lekin
/// yozuvni saqlamasdan chiqib ketdi) va tozalash amali bilan o'chiriladi.
model MediaFile {
  id           String   @id @default(cuid())
  /// R2 dagi kalit: `YYYY/MM/<uuid>.<ext>`. Asl fayl nomiga bog'liq emas.
  key          String   @unique
  originalName String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  /// `news`, `publication`, `employee`, `partner`, `document`
  ownerType    String?
  ownerId      String?
  createdAt    DateTime @default(now())

  @@index([ownerType, ownerId])
  @@map("media_files")
}

/// Me'yoriy hujjatlar, buyruqlar va nizomlar.
model Document {
  id             String    @id @default(cuid())
  titleUz        String
  titleEn        String
  titleRu        String
  descriptionUz  String?   @db.Text
  descriptionEn  String?   @db.Text
  descriptionRu  String?   @db.Text
  /// `MediaFile.key` — fayl R2 da shu kalit bilan yotadi.
  fileKey        String
  documentNumber String?
  documentDate   DateTime?
  category       String    @default("other")
  order          Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("documents")
}

/// Xatoliklar jurnali.
///
/// Yozuvlar `fingerprint` bo'yicha GURUHLANADI: bir xil xato takrorlansa
/// yangi qator yaratilmaydi, `count` oshadi va `lastSeenAt` yangilanadi.
/// Busiz bitta takrorlanuvchi xato bazani bir kechada to'ldirib qo'yadi.
///
/// DIQQAT: bu jadvalga parol, token, `Authorization`/`Cookie` sarlavhasi,
/// murojaat matni yoki ulanish satri HECH QACHON tushmasligi kerak —
/// `apps/api/src/lib/redact.ts` shuni ta'minlaydi.
model ErrorLog {
  id          String   @id @default(cuid())
  /// Xato matni + zanjirning birinchi qatori + yo'ldan olingan qisqa xesh.
  fingerprint String   @unique
  /// `server` yoki `client`
  source      String
  /// `error`, `warning`, `info`
  level       String   @default("error")
  /// 07-topshiriqdagi xato kodi, agar bo'lsa
  code        String?
  message     String   @db.Text
  stack       String?  @db.Text
  path        String?
  method      String?
  statusCode  Int?
  userAgent   String?
  adminId     String?
  count       Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  isResolved  Boolean  @default(false)
  note        String?  @db.Text

  @@index([lastSeenAt])
  @@index([isResolved, lastSeenAt])
  @@map("error_logs")
}
