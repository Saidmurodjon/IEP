# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/energetika?sslmode=require"

# JWT Secret (generate: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# Admin hisobi — `npm run db:seed` shu qiymatlardan foydalanadi.
# ADMIN_PASSWORD majburiy: o'rnatilmasa seed xato bilan to'xtaydi (default parol qo'yilmaydi).
# Kamida 10 belgi. Kuchli parol yaratish: openssl rand -base64 24
# Diqqat: seed qayta ishga tushirilsa, mavjud admin paroli shu qiymatga yangilanadi.
ADMIN_EMAIL="admin@energetika.uz"
ADMIN_PASSWORD=""

# API URL (used by frontend)
VITE_API_URL="http://localhost:3000"

# Cloudflare (for deployment)
CLOUDFLARE_ACCOUNT_ID="your-cf-account-id"
CLOUDFLARE_API_TOKEN="your-cf-api-token"

# Email (for contact form)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@gmail.com"
SMTP_PASS="your-app-password"
